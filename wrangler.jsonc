{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polimer-etp-cl",
  "main": "_worker.js",
  "compatibility_date": "2026-05-14",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "polimer-leads",
      "database_id": "fb23b713-dc4f-4aef-97aa-66fcfb02b705"
    }
  ]
}
